{{- /* Explicitly repository-owned VS Code settings. This JSONC file is parsed and merged over
       each live profile's settings.json by its modify_settings.json source. Keys absent here are
       app-owned and survive. Each array named here is owned as a complete value. Removing a key
       releases it; it does not delete the existing live value. */ -}}
{{- $profile := includeTemplate "ai-profile.yaml" . | fromYaml -}}
{
  // Editor behavior
  "editor.suggestSelection": "first",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.fontSize": 12.5,
  "editor.fontFamily": "JetBrains Mono, Cascadia Mono, Fantasque Sans Mono, Consolas, monospace",
  "editor.mouseWheelZoom": true,
  "editor.renderWhitespace": "all",
  "editor.renderControlCharacters": true,
  "editor.linkedEditing": true,
  "editor.snippetSuggestions": "top",
  "editor.stickyScroll.enabled": true,
  "editor.foldingImportsByDefault": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "smooth",
  "editor.smoothScrolling": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  // Use workspace settings for project-specific formatter differences.
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.semi": true,
  "prettier.tabWidth": 2,
  "prettier.useTabs": false,
  // Language tooling
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "emmet.triggerExpansionOnTab": true,
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "typescript": "typescriptreact",
    "javascriptreact": "html",
    "typescriptreact": "html",
    "cshtml": "html",
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
  ],
  // Language overrides
  "[cshtml]": {
    "editor.linkedEditing": false,
    "editor.formatOnPaste": false,
  },
  "[markdown]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.markdownlint": "explicit",
    },
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
  },
  // Source control
  "scm.inputFontFamily": "JetBrains Mono, Cascadia Code, Consolas, monospace",
  "scm.inputMinLineCount": 3,
  "scm.inputMaxLineCount": 10,
  "scm.repositories.selectionMode": "single",
  "[scminput]": {
    "editor.rulers": [
      50,
      72
    ],
    "editor.wordWrap": "off",
  },
  // Files and associations
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.autoSaveDelay": 1000,
  "files.associations": {
    "*.gml": "xml",
    "*.geojson": "json",
  },
  // Diff editor
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": false,
  "diffEditor.experimental.showMoves": true,
  // Workbench UI
  "breadcrumbs.enabled": true,
  "workbench.iconTheme": "vscode-icons",
  "workbench.colorTheme": "Dracula Theme",
  "workbench.editorAssociations": {
    "git-rebase-todo": "default",
  },
  "workbench.browser.enableChatTools": true,
  "workbench.list.smoothScrolling": true,
  "debug.breakpointsView.presentation": "tree",
  // Previews and notebooks
  "svg.preview.background": "editor",
  "notebook.formatOnSave.enabled": true,
  // Tasks
  "task.slowProviderWarning": [
    "typescript"
  ],
  "task.notifyWindowOnTaskCompletion": 0,
  // Terminal
  // Put a Nerd Font first for terminal icons; JetBrains Mono and Consolas are fallbacks.
  "terminal.integrated.fontFamily": "MesloLGS NF, JetBrains Mono, Consolas, monospace",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 4,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.fontSize": 12.5,
  "terminal.integrated.initialHint": false,
  // Git
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "always",
  "git.allowForcePush": false,
  "git.confirmForcePush": true,
  "git.suggestSmartCommit": false,
  "git.detectWorktrees": true,
  "gitlens.views.commitDetails.files.layout": "tree",
  "git.worktreeIncludeFiles": [
    "**/CLAUDE.local.md",
    "**/AGENTS.override.md",
    "**/.env",
    "**/.env.local",
    "**/.env.development",
    "**/.env.development.local",
    "**/.env.test",
    "**/.env.test.local",
    "**/connections.config",
    "**/appsettings.secret.config",
    "**/appsettings.Development.json",
  ],
  // Copilot
  "github.copilot.selectedCompletionModel": "",
  "github.copilot.nextEditSuggestions.enabled": true,
{{- if eq $profile.ai_context "company" }}
  // Traditional Chinese version of commit message guidelines
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Use Conventional Commits format as type(scope): summary or type: summary when scope is omitted. Keep type in English only and use exactly one of feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert. Use zh-TW for summary and for scope when present. Keep summary concise, imperative, and without a trailing period. Keep subject line within 72 characters when possible. Output one commit header only, with an optional body.",
    },
    {
      "text": "Prefer page name as scope for page-specific changes. For non-page changes, use a broader module scope such as 購物車, 會員, or api, and omit scope only when no single area fits. If changes are long or mixed, such as 3 or more key points, keep the first line high-level and put details in body bullets. Add body bullets only when needed, and make bullets concrete without repeating the summary line.",
    },
    {
      "text": "Follow these examples exactly in style: feat(登入頁): 新增 Google 登入流程; fix(購物車): 修正結帳時數量未同步; docs(開發文件): 更新本機開發步驟; style(商品頁): 調整商品卡切版與間距; chore: 更新相依套件; feat(商品頁): 串接商品列表 API with body bullets 新增商品列表 API 請求流程, 加入載入中與錯誤狀態處理, 補上空資料提示文案; fix(購物車): 修正結帳 API 串接錯誤 with body bullets 修正請求參數欄位名稱不一致, 統一錯誤碼對應訊息, 避免重複送出造成重複結帳; refactor(會員): 抽離登入驗證邏輯 with body bullets 將驗證判斷集中到共用模組, 移除頁面內重複驗證程式碼, 保持原本登入流程行為不變.",
    },
    {
      "text": "When staged changes contain only non-code files such as .md, .prompt.md, .instructions.md, or files under prompts/, notes/, docs/, or similar meta directories, use chore or docs as the type. Base the scope and summary on what the FILE ITSELF is (its filename or folder), not on any feature, subject, or description written inside the file's content or frontmatter. Keep technical filenames, tool names, and English identifiers in their original form — do not translate them into zh-TW. For example, adding stream-tester-ongoing.prompt.md should produce: chore(prompts): 新增 stream-tester-ongoing prompt 檔案. Do not produce: a feat describing the feature the prompt discusses; or chore(prompts): 新增 stream-tester 進行中 prompt which wrongly translates the filename.",
    },
  ],
{{- else }}
  // English version of commit message guidelines
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Use Conventional Commits format as type(scope): summary or type: summary when scope is omitted. Keep type in English only and use exactly one of feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert. Use English for summary and for scope when present. Keep summary concise, imperative, and without a trailing period. Keep subject line within 72 characters when possible. Output one commit header only, with an optional body.",
    },
    {
      "text": "Prefer page name as scope for page-specific changes. For non-page changes, use a broader module scope such as cart, member, or api, and omit scope only when no single area fits. If changes are long or mixed, such as 3 or more key points, keep the first line high-level and put details in body bullets. Add body bullets only when needed, and make bullets concrete without repeating the summary line.",
    },
    {
      "text": "Follow these examples exactly in style: feat(login-page): add Google login flow; fix(cart): fix quantity not syncing during checkout; docs(dev-docs): update local development steps; style(product-page): adjust product card layout and spacing; chore: update dependencies; feat(product-page): integrate product list API with body bullets add product list API request flow, add loading and error state handling, add empty state message; fix(cart): fix checkout API integration issue with body bullets fix inconsistent request parameter field names, standardize error-code-to-message mapping, prevent duplicate checkout caused by repeated submit; refactor(member): extract login validation logic with body bullets centralize validation checks into shared module, remove duplicate validation code in page, keep existing login flow behavior unchanged.",
    },
    {
      "text": "When staged changes contain only non-code files such as .md, .prompt.md, .instructions.md, or files under prompts/, notes/, docs/, or similar meta directories, use chore or docs as the type. Base the scope and summary on what the FILE ITSELF is (its filename or folder), not on any feature, subject, or description written inside the file's content or frontmatter. Keep technical filenames, tool names, and identifiers in their original form. For example, adding stream-tester-ongoing.prompt.md should produce: chore(prompts): add stream-tester-ongoing prompt file. Do not produce a feat describing the feature the prompt discusses.",
    },
  ],
{{- end }}
  // Copilot language assistance
  "github.copilot.chat.languageContext.fix.typescript.enabled": true,
  "github.copilot.chat.languageContext.inline.typescript.enabled": true,
  "github.copilot.chat.languageContext.typescript.enabled": true,
  // Live Server and Sass settings (shared across profiles; used for work projects).
  "liveServer.settings.donotShowInfoMsg": true,
  "liveServer.settings.donotVerifyTags": true,
  "liveSassCompile.settings.excludeList": [
    "/node_modules/",
    "/vscode/"
  ],
  "liveSassCompile.settings.formats": [
    {
      "format": "expanded",
      "extensionName": ".css",
      "savePath": null,
    },
  ],
  "liveSassCompile.settings.generateMap": false,
  "liveSassCompile.settings.autoprefix": [
    "> 1%",
    "last 2 versions"
  ],
  // Chat extensions and instruction discovery
  // Enable Copilot Agent Plugins so VS Code loads installed or locally configured plugins.
  "chat.plugins.enabled": true,
  // Load repository AGENTS.md instructions in VS Code Copilot sessions.
  "chat.useAgentsMdFile": true,
  "chat.includeReferencedInstructions": true,
  // Use VS Code's own instruction paths to avoid duplicate shared rules and Claude-specific guidance.
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": true,
    "~/.copilot/instructions": true,
    "~/.claude/rules": false
  },
  "chat.useClaudeMdFile": false,
  // Agent and chat behavior
  "inlineChat.affordance": "gutter",
  "inlineChat.askInChat": false,
  "chat.mcp.autostart": "always",
  "chat.mcp.gallery.enabled": true,
  "chat.useCustomizationsInParentRepositories": true,
  "chat.subagents.allowInvocationsFromSubagents": true,
  "github.copilot.chat.agentDebugLog.enabled": true,
  "github.copilot.chat.agentDebugLog.fileLogging.enabled": true,
  // Allow chat to request URLs and receive responses from these sites.
  "chat.tools.urls.autoApprove": {
