    "https://code.visualstudio.com/docs": true,
    "https://*.visualstudio.com": true,
    "https://code.visualstudio.com/docs/copilot/customization/custom-instructions": true,
    "https://code.visualstudio.com/docs/copilot/customization": true,
    "https://code.visualstudio.com/docs/copilot": true,
