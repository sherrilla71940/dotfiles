  // Enable GitHub Copilot Agent Plugins so VS Code loads installed or locally configured plugins.
  "chat.plugins.enabled": true,
  // Always load this repository's AGENTS.md so Copilot follows the same dotfiles workflow as other agents.
  "chat.useAgentsMdFile": true,
  "chat.includeReferencedInstructions": true,
  // Copilot reads several harness-agnostic user folders by default, and this dotfiles repo
  // renders the same rules into more than one of them. Without these two settings each
  // shared rule is listed twice, and Copilot also ingests ~/.claude/CLAUDE.md, whose lower
  // half is Claude Code-only (Agent calls, claude-code-guide, the Bash/PowerShell tools).
  // Copilot gets its own copies from ~/.copilot/instructions instead.
  // This affects VS Code only. Claude Code still reads ~/.claude/rules itself, and Copilot CLI
  // is unaffected either way: it reads ~/.copilot/instructions plus the repository's own
  // AGENTS.md and CLAUDE.md, never ~/.claude/rules, so it has no duplicate to suppress.
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": true,
    "~/.copilot/instructions": true,
    "~/.claude/rules": false
  },
