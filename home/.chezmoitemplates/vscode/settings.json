  // Linting
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
  ],
  // temporarily disable for CMS project
  // "editor.codeActionsOnSave": {
  //   "source.fixAll.eslint": "explicit",
  // },
  // Language overrides
  "[cshtml]": {
    "editor.linkedEditing": false,
    "editor.formatOnPaste": false,
  },
  "[markdown]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.markdownlint": "explicit",
    },
  },
  // Source control
  "scm.inputFontFamily": "JetBrains Mono, Cascadia Code, Consolas, monospace",
  // "scm.inputFontFamily": "Cascadia Mono, Fantasque Sans Mono, Fira Code Q",
  "scm.inputMinLineCount": 3,
  "scm.inputMaxLineCount": 10,
  "[scminput]": {
    "editor.rulers": [
      50,
      72
    ],
    "editor.wordWrap": "off",
  },
  // Files and associations
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.autoSaveDelay": 1000,
  "files.associations": {
    "*.gml": "xml",
    "*.geojson": "json",
  },
  // Diff editor
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": false,
  "diffEditor.experimental.showMoves": true,
  // Workbench UI
  "breadcrumbs.enabled": true,
  "workbench.iconTheme": "vscode-icons",
  "workbench.editorAssociations": {
    "git-rebase-todo": "default",
  },
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.bracketPairColorization.enabled": true,
  // Previews and notebooks
  "svg.preview.background": "editor",
  "notebook.formatOnSave.enabled": true,
  // Tasks
  "task.slowProviderWarning": [
    "typescript"
  ],
  // Terminal
  "terminal.integrated.fontFamily": "MesloLGS NF",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 4,
  "terminal.integrated.cursorBlinking": false,
  "task.notifyWindowOnTaskCompletion": 0,
  "terminal.integrated.fontSize": 13,
  // Git
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "always",
  "git.allowForcePush": false,
  "git.confirmForcePush": true,
  "git.suggestSmartCommit": false,
  // Copilot
  "github.copilot.selectedCompletionModel": "",
  "github.copilot.nextEditSuggestions.enabled": true,
  // "github.copilot.advanced": {},
  // Chinese version of commit message guidelines
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Use Conventional Commits format as type(scope): summary or type: summary when scope is omitted. Keep type in English only and use exactly one of feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert. Use zh-TW for summary and for scope when present. Keep summary concise, imperative, and without a trailing period. Keep subject line within 72 characters when possible. Output one commit header only, with an optional body.",
    },
    {
      "text": "Prefer page name as scope for page-specific changes. For non-page changes, use a broader module scope such as 購物車, 會員, or api, and omit scope only when no single area fits. If changes are long or mixed, such as 3 or more key points, keep the first line high-level and put details in body bullets. Add body bullets only when needed, and make bullets concrete without repeating the summary line.",
    },
    {
      "text": "Follow these examples exactly in style: feat(登入頁): 新增 Google 登入流程; fix(購物車): 修正結帳時數量未同步; docs(開發文件): 更新本機開發步驟; style(商品頁): 調整商品卡切版與間距; chore: 更新相依套件; feat(商品頁): 串接商品列表 API with body bullets 新增商品列表 API 請求流程, 加入載入中與錯誤狀態處理, 補上空資料提示文案; fix(購物車): 修正結帳 API 串接錯誤 with body bullets 修正請求參數欄位名稱不一致, 統一錯誤碼對應訊息, 避免重複送出造成重複結帳; refactor(會員): 抽離登入驗證邏輯 with body bullets 將驗證判斷集中到共用模組, 移除頁面內重複驗證程式碼, 保持原本登入流程行為不變.",
    },
    {
      "text": "When staged changes contain only non-code files such as .md, .prompt.md, .instructions.md, or files under prompts/, notes/, docs/, or similar meta directories, use chore or docs as the type. Base the scope and summary on what the FILE ITSELF is (its filename or folder), not on any feature, subject, or description written inside the file's content or frontmatter. Keep technical filenames, tool names, and English identifiers in their original form — do not translate them into zh-TW. For example, adding stream-tester-ongoing.prompt.md should produce: chore(prompts): 新增 stream-tester-ongoing prompt 檔案. Do not produce: a feat describing the feature the prompt discusses; or chore(prompts): 新增 stream-tester 進行中 prompt which wrongly translates the filename.",
    },
    // English version of commit message guidelines
    // {
    //   "text": "Use Conventional Commits format as type(scope): summary or type: summary when scope is omitted. Keep type in English only and use exactly one of feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert. Use English for summary and for scope when present. Keep summary concise, imperative, and without a trailing period. Keep subject line within 72 characters when possible. Output one commit header only, with an optional body.",
    // },
    // {
    //   "text": "Prefer page name as scope for page-specific changes. For non-page changes, use a broader module scope such as cart, member, or api, and omit scope only when no single area fits. If changes are long or mixed, such as 3 or more key points, keep the first line high-level and put details in body bullets. Add body bullets only when needed, and make bullets concrete without repeating the summary line.",
    // },
    // {
    //   "text": "Follow these examples exactly in style: feat(login-page): add Google login flow; fix(cart): fix quantity not syncing during checkout; docs(dev-docs): update local development steps; style(product-page): adjust product card layout and spacing; chore: update dependencies; feat(product-page): integrate product list API with body bullets add product list API request flow, add loading and error state handling, add empty state message; fix(cart): fix checkout API integration issue with body bullets fix inconsistent request parameter field names, standardize error-code-to-message mapping, prevent duplicate checkout caused by repeated submit; refactor(member): extract login validation logic with body bullets centralize validation checks into shared module, remove duplicate validation code in page, keep existing login flow behavior unchanged.",
    // },
  ],
  "github.copilot.chat.languageContext.fix.typescript.enabled": true,
