{{- /* Durable, repository-owned Windows Terminal settings.

       This file is data, not logic. It is deep-merged over the live
       settings.json by the sibling modify_settings.json, and the repository wins
       on any key named here. Every key absent from this file belongs to Windows
       Terminal and survives untouched - profiles, their generated GUIDs, schemes
       and themes among them.

       actions entries are owned by id and keybindings by keys; entries not named
       here survive from the live file. A repository-owned id or key chord wins a
       collision. profiles.list stays unnamed because it holds generated
       per-machine GUIDs this repository cannot supply. See ADR-0050. */ -}}

{
  "profiles": {
    "defaults": {
      {{/* MesloLGS NF is a Nerd Font. Terminal output draws powerline separators,
           box-drawing and icon glyphs that an unpatched family renders as tofu, so
           this is a functional requirement on every machine rather than a taste
           setting. It is the same face the VS Code terminal names. */}}
      "font": {
        "face": "MesloLGS NF"
      },

      {{/* Grayscale antialiasing renders light-on-dark heavier than dark-on-light,
           so a highlighted row and a normal row appear to differ in weight when
           only the colors differ. ClearType renders subpixel and closes most of
           that gap. Windows Terminal applies this to new instances only. */}}
      "antialiasingMode": "cleartype"
    }
  },

  {{/* Shift+Enter has to reach a terminal user interface as a sequence distinct
       from Enter, or a multi-line prompt cannot be typed. ESC CR is what Claude
       Code's own /terminal-setup writes, and the same sequence this repository
       already binds for the VS Code terminal in vscode/keybindings.json, so both
       terminals hand Claude Code identical bytes.

       Windows Terminal rejects the \x1b spelling in sendInput; the escape
       character must be written as \u001b. */}}
  "actions": [
    {
      "command": { "action": "sendInput", "input": "\u001b\r" },
      "id": "User.SendNewline",
      "name": "Insert a line break"
    }
  ],

  {{/* These durable shortcuts belong to the repository. Other key chords added
       through the settings UI are retained by the modify template. */}}
  "keybindings": [
    { "id": "User.SendNewline", "keys": "shift+enter" },
    { "id": "Terminal.CopyToClipboard", "keys": "ctrl+c" },
    { "id": "Terminal.PasteFromClipboard", "keys": "ctrl+v" },
    { "id": "Terminal.DuplicatePaneAuto", "keys": "alt+shift+d" }
  ]
}
