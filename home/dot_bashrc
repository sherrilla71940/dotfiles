# Add Winget command shims to Git Bash without hardcoding a user profile path.
if [ -n "${LOCALAPPDATA:-}" ] && command -v cygpath >/dev/null 2>&1; then
    winget_links="$(cygpath -u "$LOCALAPPDATA/Microsoft/WinGet/Links")"
    case ":$PATH:" in
        *":$winget_links:"*) ;;
        *) export PATH="$PATH:$winget_links" ;;
    esac
    unset winget_links
fi

# Load NVM only when a Node-family command is first used.
export NVM_DIR="$HOME/.nvm"

_load_nvm() {
    unset -f nvm node npm npx
    [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"
}

nvm() { _load_nvm; nvm "$@"; }
node() { _load_nvm; node "$@"; }
npm() { _load_nvm; npm "$@"; }
npx() { _load_nvm; npx "$@"; }

# Load Git completion from Git for Windows or either common Homebrew prefix.
for git_completion in \
    /mingw64/share/git/completion/git-completion.bash \
    /opt/homebrew/etc/bash_completion.d/git-completion.bash \
    /usr/local/etc/bash_completion.d/git-completion.bash; do
    if [ -f "$git_completion" ]; then
        . "$git_completion"
        break
    fi
done
unset git_completion

# Use HOME so these shortcuts work in Git Bash and macOS shells.
alias work='cd "$HOME/Documents/work"'
alias personal='cd "$HOME/Documents"'

# Recalculate terminal dimensions after each command to keep wrapping correct.
shopt -s checkwinsize

# Dotfiles shortcuts. Shared instructions live outside any single client's source tree.
alias dotf='chezmoi cd'
alias dotf-core='"${EDITOR:-code}" "$(chezmoi source-path)/.chezmoitemplates/core.md"'
alias dotf-claude='chezmoi edit ~/.claude/CLAUDE.md'
alias dotf-diff='chezmoi diff'
alias dotf-apply='chezmoi apply -v'
