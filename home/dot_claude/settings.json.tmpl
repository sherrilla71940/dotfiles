{{- /* One settings file for both platforms. Previously two files that had to be kept in
       sync by hand. Hook and statusline paths point at ~/.claude directly because the old
       ~/.claude/dotfiles symlink no longer exists -- chezmoi copies these files into place. */ -}}
{
  "env": {
    "API_TIMEOUT_MS": "1200000",
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
{{- if eq .chezmoi.os "windows" }}
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0",
    "CLAUDE_CODE_GIT_BASH_PATH": "{{ .chezmoi.homeDir | replace "/" "\\\\" }}\\AppData\\Local\\Programs\\Git\\bin\\bash.exe",
{{- end }}
    "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN": "1"
  },
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|idle_prompt",
        "hooks": [
          {
            "type": "command",
{{- if eq .chezmoi.os "windows" }}
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$HOME/.claude/hooks/show-claude-notification.ps1\"",
{{- else }}
            "command": "bash \"$HOME/.claude/hooks/show-claude-notification-macos.sh\"",
{{- end }}
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|fork",
        "hooks": [
          {
            "type": "command",
{{- if eq .chezmoi.os "windows" }}
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$HOME/.claude/hooks/check-worktree-launch.ps1\"",
{{- else }}
            "command": "bash \"$HOME/.claude/hooks/check-worktree-launch.sh\"",
{{- end }}
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
{{- if eq .chezmoi.os "windows" }}
    "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$HOME/.claude/claude-session-statusline.ps1\""
{{- else }}
    "command": "bash \"$HOME/.claude/claude-session-statusline.sh\""
{{- end }}
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "theme": "auto",
  "verbose": true,
  "tui": "default"
}
