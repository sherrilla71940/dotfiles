{{- /* Keep the user-level session-end notification. Workspace and task lifecycle
       behavior follows the active client's native defaults. */ -}}
{{- $notifyCommand := "bash \"$HOME/.local/share/show-agent-notification-macos.sh\"" -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $pwsh := "powershell.exe -NoProfile -ExecutionPolicy Bypass -File" -}}
{{-   $notifyCommand = printf "%s %s/.local/share/show-agent-notification.ps1" $pwsh .chezmoi.homeDir -}}
{{- end -}}
{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": {{ $notifyCommand | toJson }}, "timeout": 3 }
        ]
      }
    ]
  }
}
