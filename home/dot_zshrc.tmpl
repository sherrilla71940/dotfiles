{{- /* zsh is the macOS default shell. This mirrors dot_bashrc's behaviour rather than
       introducing new habits: lazy NVM, Git completion, and the same navigation aliases.
       Windows has no zsh, so the whole file renders empty there. */ -}}
{{ if ne .chezmoi.os "windows" -}}
# Load NVM lazily, so every shell start does not pay the initialisation cost.
export NVM_DIR="$HOME/.nvm"

_load_nvm() {
    unset -f nvm node npm npx
    [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
}

nvm() { _load_nvm; nvm "$@"; }
node() { _load_nvm; node "$@"; }
npm() { _load_nvm; npm "$@"; }
npx() { _load_nvm; npx "$@"; }

# zsh ships its own Git completion, loaded through compinit, so bash's git-completion.bash
# is not needed.
autoload -Uz compinit
compinit -u

# Use HOME so these shortcuts stay identical to the ones in dot_bashrc.
alias work='cd "$HOME/Documents/work"'
alias personal='cd "$HOME/Documents"'

# zsh handles terminal resizing itself, so bash's shopt -s checkwinsize is not needed.

# Dotfiles editing shortcuts. The shared working agreement is read by Claude, Codex and
# Copilot alike, so it lives in no single tool's file; only Claude-specific rules sit in
# CLAUDE.md.tmpl.
alias dotf='chezmoi cd'
alias dotf-core='"${EDITOR:-code}" "$(chezmoi source-path)/.chezmoitemplates/core.md"'
alias dotf-claude='chezmoi edit ~/.claude/CLAUDE.md'
alias dotf-diff='chezmoi diff'
alias dotf-apply='chezmoi apply -v'
{{- end }}
