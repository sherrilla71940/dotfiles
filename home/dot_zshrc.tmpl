{{- /* zsh is the macOS default shell. This mirrors dot_bashrc's behaviour rather than
       introducing new habits: lazy NVM, Git completion, and the same navigation aliases.
       Windows has no zsh, so the whole file renders empty there. */ -}}
{{ if ne .chezmoi.os "windows" -}}
# 延遲載入 NVM，避免每次啟動 shell 都付出初始化成本。
export NVM_DIR="$HOME/.nvm"

_load_nvm() {
    unset -f nvm node npm npx
    [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
}

nvm() { _load_nvm; nvm "$@"; }
node() { _load_nvm; node "$@"; }
npm() { _load_nvm; npm "$@"; }
npx() { _load_nvm; npx "$@"; }

# zsh 自帶 Git 補全，透過 compinit 載入即可，不需要 bash 的 git-completion.bash。
autoload -Uz compinit
compinit -u

# 使用 HOME，讓捷徑與 dot_bashrc 保持一致。
alias work='cd "$HOME/Documents/work"'
alias personal='cd "$HOME/Documents"'

# zsh 會自行處理終端尺寸變化，因此不需要 bash 的 shopt -s checkwinsize。
{{- end }}
