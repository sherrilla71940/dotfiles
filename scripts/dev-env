#!/usr/bin/env bash
# Repository-local developer-environment entry point; this is not rendered by chezmoi.
# Usage: bash scripts/dev-env <command>
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

case "${1:-}" in
  doctor)
    shift
    exec bash "$script_dir/diagnostics/dev-env-doctor.sh" "$@"
    ;;
  *)
    printf 'usage: %s doctor\n' "$0" >&2
    exit 2
    ;;
esac
